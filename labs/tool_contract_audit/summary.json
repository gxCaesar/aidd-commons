{
  "boundary": "A passing return record establishes a self-describing laboratory artefact. It does not establish that its measurement is true, that the tool ran in the environment it names, or that a reader can reproduce the result from the record alone.",
  "computed_on": "2026-10-24",
  "contract": {
    "environment": {
      "required": [
        "software.python",
        "environment.requires",
        "environment.unavailable",
        "environment.can_attest_external_execution"
      ],
      "rule": "The return must name a Python software version and nonempty requirement and unavailable lists. can_attest_external_execution must be false. These are declarations, not an independent process trace.",
      "unavailable": [
        "external execution attestation",
        "proof of runtime hardware from a return record"
      ]
    },
    "error_states": {
      "field": "outcome_status",
      "must_stop": [
        "halt"
      ],
      "no_usable_result": [
        "no_result",
        "halt"
      ],
      "observed_field_names": [
        "run_status",
        "status",
        "error",
        "errors"
      ],
      "rule": "The outcome_status field must have one declared value. no_result licenses no usable result and halt requires stopping. Missing status cannot be inferred as complete. Existing laboratories have no uniform top-level error field.",
      "statuses": [
        "complete",
        "no_result",
        "halt"
      ]
    },
    "schema": {
      "field_coverage": [
        "schema_version",
        "protocol_id",
        "computed_on",
        "software",
        "environment",
        "side_effects",
        "outcome_status",
        "scientific_meaning",
        "software.python",
        "environment.requires",
        "environment.unavailable",
        "environment.can_attest_external_execution",
        "side_effects.allowed_writes",
        "scientific_meaning.licenses",
        "scientific_meaning.does_not_license",
        "boundary",
        "does_not_do",
        "does_not_show",
        "excluded_by_design",
        "interpretation_limits",
        "limit_statement",
        "limits",
        "run_status",
        "status",
        "error",
        "errors"
      ],
      "required": {
        "computed_on": "iso_date",
        "environment": "object",
        "outcome_status": "status",
        "protocol_id": "nonempty_string",
        "schema_version": "nonempty_string",
        "scientific_meaning": "object",
        "side_effects": "object",
        "software": "version_map"
      },
      "rule": "Each required field must be present with its declared type and a value. Missing and empty or invalid values are distinct failures. Extra result fields are allowed because laboratories have different outputs."
    },
    "scientific_meaning": {
      "field": "scientific_meaning",
      "limit_field_names": [
        "boundary",
        "does_not_do",
        "does_not_show",
        "excluded_by_design",
        "interpretation_limits",
        "limit_statement",
        "limits"
      ],
      "required": [
        "licenses",
        "does_not_license"
      ],
      "rule": "Both meaning statements must be nonempty strings. A pass licenses only a self-describing artefact, not measurement truth or independent reproduction. Count existing limit declarations separately without treating them as this full statement."
    },
    "side_effects": {
      "field": "side_effects.allowed_writes",
      "rule": "Declare a list of repository-relative paths that the tool may write. An empty list makes a no-write claim checkable against a separate trace. The return record alone cannot prove that actual writes obeyed it."
    },
    "version": {
      "fields": [
        "schema_version",
        "protocol_id"
      ],
      "rule": "Both fields must be nonempty strings. Without either field the record cannot be read as a versioned artefact. This does not validate the protocol's science."
    }
  },
  "environment": {
    "can_attest_external_execution": false,
    "requires": [
      "Python 3.11",
      "committed local laboratory return records"
    ],
    "unavailable": [
