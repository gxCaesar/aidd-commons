      "structure_id": "1IVO"
    },
    {
      "accession": "P04626",
      "symbol": "ERBB2",
      "name": "Receptor protein-tyrosine kinase erbB-2",
      "structure_id": "3MZW"
    },
    {
      "accession": "P00374",
      "symbol": "DHFR",
      "name": "Dihydrofolate reductase",
      "structure_id": "1BOZ"
    },
    {
      "accession": "P04637",
      "symbol": "TP53",
      "name": "Cellular tumor antigen p53",
      "structure_id": "1YCS"
    },
    {
      "accession": "P03372",
      "symbol": "ESR1",
      "name": "Estrogen receptor",
      "structure_id": "11SD"
    },
    {
      "accession": "P08183",
