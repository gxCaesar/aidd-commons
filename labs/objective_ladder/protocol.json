{
  "schema_version": "aidd-commons.objective-ladder-protocol.v1",
  "protocol_id": "objective-ladder-six-objectives-v1",
  "issued_on": "2026-10-22",
  "declared_question": "For each examined entity, which of the six objectives has a public record that actually carries evidence at that level, and which does not?",
  "objectives": [
    "sequence-recovery",
    "folding",
    "structural-plausibility",
    "binding",
    "catalysis",
    "function"
  ],
  "sources": [
    {
      "key": "uniprot",
      "name": "UniProtKB",
      "licence": "CC BY 4.0",
      "route": "https://rest.uniprot.org/uniprotkb/{accession}.json"
    },
    {
      "key": "alphafold-db",
      "name": "AlphaFold Protein Structure Database",
      "licence": "CC BY 4.0",
      "route": "https://alphafold.ebi.ac.uk/api/prediction/{accession}"
    },
    {
      "key": "rcsb",
      "name": "RCSB Protein Data Bank",
      "licence": "CC0 1.0",
      "route": "https://data.rcsb.org/rest/v1/core/entry/{entry_id}"
    },
    {
      "key": "rcsb-search",
      "name": "RCSB Search API",
      "licence": "CC0 1.0",
      "route": "https://search.rcsb.org/rcsbsearch/v2/query"
    },
    {
      "key": "skempi",
      "name": "SKEMPI 2.0",
      "licence": "CC BY 4.0",
      "route": "https://huggingface.co/datasets/LiteFold/SKEMPI2/resolve/main/tables/labeled_skempi2_skempi_v2.csv.jsonl"
    }
  ],
  "targets": [
    {
