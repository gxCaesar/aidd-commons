  "tolerances": {
    "clash_distance_angstrom": 2.0,
    "bond_length_tolerance_angstrom": 0.45,
    "minimum_coordinate_rows": 500
  },
  "excluded_by_design": [
    "any prediction of an affinity, potency or activity value: this laboratory reads records, it does not score compounds",
    "any claim that a target is druggable, tractable or clinically validated: the laboratory reports which objective has a record, not what the record means for a programme",
    "any ranking of the examined entities: the six objectives are read separately and are not combined into a score",
    "any treatment of a predicted structure as an observation of how the entity folds: the model archive holds a model output, and the record names it as one"
  ]
}
