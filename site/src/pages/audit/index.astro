---
import { readFile } from "node:fs/promises";

import AtlasFigure from "../../components/AtlasFigure.astro";
import ComparisonMatrix from "../../components/ComparisonMatrix.astro";
import CoverageBounds from "../../components/CoverageBounds.astro";
import SiteShell from "../../components/SiteShell.astro";
import {
  comparisonTrackTitle,
  type ComparisonPayload,
} from "../../data/comparison.js";

const comparison = JSON.parse(
  await readFile(
    new URL("../../../public/data/comparison.v1.json", import.meta.url),
    "utf8",
  ),
) as ComparisonPayload;
const providerNames = new Map(
  comparison.providers.map((provider) => [provider.id, provider.name]),
);
const providerList = (ids: string[]) =>
  ids.map((id) => providerNames.get(id) ?? id).join(", ");
const publication = comparison.publication;
const label = (value: string) =>
  value
    .replaceAll(/[-_]/gu, " ")
    .replace(/^./u, (character) => character.toUpperCase());
---

<SiteShell
  title="Coverage audit"
  description="A source-grounded, interval-based comparison of AIDD learning systems by topic and instructional depth."
>
  <section class="audit-hero" aria-labelledby="audit-title">
    <div>
      <p class="eyebrow">Dated comparison · {comparison.as_of}</p>
      <h1 id="audit-title" class="page-heading">AIDD coverage audit</h1>
      <p class="page-intro">
        A transparent comparison of {comparison.providers.length} learning systems
        across {comparison.taxonomy.tracks} tracks and {comparison.taxonomy.topics}
        {" "}topics. Every cell preserves its evidence state and uncertainty.
      </p>
    </div>
    <dl class="audit-snapshot">
      <div><dt>Direct observations</dt><dd>{comparison.observations.direct_cells}</dd></div>
      <div><dt>Explicit unknowns</dt><dd>{comparison.observations.default_unverified_cells}</dd></div>
      <div><dt>Logical cells</dt><dd>{comparison.observations.total_cells}</dd></div>
      <div><dt>Schema</dt><dd>{comparison.schema_version}</dd></div>
    </dl>
  </section>

  <section class="audit-principles section" aria-labelledby="audit-principles-title">
    <div>
      <p class="meta-label">Reading rule</p>
      <h2 id="audit-principles-title">Unknown is not absent</h2>
    </div>
    <p>
      Direct observations describe only the material opened in the dated review.
      An <strong>unverified</strong> cell is deliberately unresolved. It cannot be used
      as evidence that a provider lacks a topic.
    </p>
  </section>

  <section class="section" aria-labelledby="correction-window-title" data-correction-window>
    <p class="eyebrow">Public correction window</p>
    <h2 id="correction-window-title">Both comparison claims remain not established</h2>
    {publication?.first_published_at ? (
      <>
        <p class="section-intro" data-window-status={publication.correction_window_status}>
          First publication was recorded at <time datetime={publication.first_published_at}>{publication.first_published_at}</time>.
          The {publication.correction_window_days}-day correction window ends at {publication.correction_window_ends_at};
          its status was <strong>{publication.correction_window_status}</strong> when checked on {publication.status_checked_on} (UTC).
        </p>
        <p>
          <a href={publication.correction_url!}>Submit a source-backed correction</a>.
          Elapsed time does not establish either claim. Submitted corrections and all other claim conditions still need review.
        </p>
      </>
    ) : (
      <p class="section-intro" data-window-status="not_recorded">
        No public publication timestamp or correction route has been recorded. The 30-day window starts with actual public availability, as recorded in the publication record.
      </p>
    )}
  </section>

  <div class="section">
    <CoverageBounds
      providers={comparison.providers}
      summaries={comparison.summaries}
      totalTopics={comparison.taxonomy.topics}
    />
    <p class="section-intro">
      The same {comparison.providers.length} providers, drawn: this project's own row
      is a point at every threshold because every cell behind it is a direct
      observation, and each row below it is a range whose width measures how much of
      that provider nobody has read.
    </p>
    <AtlasFigure id="coverage-bounds" />
  </div>

  <section class="section" aria-labelledby="matrix-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Evidence-adjacent cells</p>
        <h2 id="matrix-title">Interactive comparison matrix</h2>
      </div>
      <div class="audit-downloads" aria-label="Download comparison data">
        <a href="/data/comparison.v1.json" download>JSON</a>
        <a href="/data/comparison.v1.csv" download>CSV</a>
      </div>
    </div>
    <p class="section-intro">
      Filter one curriculum track at a time. Open any cell to inspect its reviewed
      scope, interpretation, source, review date, and access state in place.
    </p>
    <ComparisonMatrix providers={comparison.providers} rows={comparison.rows} />
  </section>

  <section class="section" aria-labelledby="gaps-title" data-gap-view>
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Depth work queue</p>
        <h2 id="gaps-title">Confirmed depth gaps</h2>
      </div>
      <p class="gap-count">{comparison.gaps.candidates.length} confirmed</p>
    </div>
    <p class="section-intro">
      These are direct AIDD Commons observations below worked depth where at least
      one external system has direct evidence at worked depth or deeper. They are
      the evidence-backed input to the separately validated frozen selection rule.
    </p>
    {comparison.gaps.candidates.length === 0 ? (
      <p class="section-intro" data-gap-empty>
        No evidence-backed depth gap is identified in the current records. This count
        moves only with a new review or new teaching material, and it says nothing
        about topics still recorded as unverified.
      </p>
    ) : (
      <ol class="gap-grid">
        {comparison.gaps.candidates.map((gap) => (
          <li>
            <article class="gap-card">
              <p class="meta-label">{comparisonTrackTitle(gap.track_id)} · {gap.topic_core ? "core" : "extended"}</p>
              <h3>{gap.topic_title}</h3>
              <dl>
                <div><dt>AIDD Commons</dt><dd>{label(gap.self_depth)}</dd></div>
                <div><dt>External depth</dt><dd>{label(gap.strongest_external_depth)}</dd></div>
              </dl>
              <p><strong>Observed in:</strong> {providerList(gap.external_providers_at_worked_or_deeper)}</p>
            </article>
          </li>
        ))}
      </ol>
    )}
    {comparison.gaps.selected_depth_candidates.length > 0 ? (
      <div class="candidate-tranche" aria-labelledby="candidate-tranche-title">
        <div class="candidate-tranche__heading">
          <div>
            <p class="meta-label">Frozen selection · live implementation state</p>
            <h3 id="candidate-tranche-title">Frozen v0.2b depth candidates</h3>
          </div>
          <p class="candidate-status">
            {comparison.gaps.selected_depth_candidates.length} selected
          </p>
        </div>
        <p>
          Every candidate passed the seven frozen eligibility checks. Rank follows
          transitive prerequisite value, then lower maintenance burden. Status may
          advance without rewriting the selection snapshot. The contract and
          resource estimates below describe selection-time feasibility; the
          implementation status and result note describe current delivery.
        </p>
        <ol class="candidate-grid">
          {comparison.gaps.selected_depth_candidates.map((candidate, index) => (
            <li>
              <article class="candidate-card">
                <p class="candidate-rank">Rank {index + 1} · {comparisonTrackTitle(candidate.track_id)}</p>
                <p class={`candidate-lifecycle candidate-lifecycle--${candidate.implementation.status}`}>
                  {label(candidate.implementation.status)}
                </p>
                <h4>{candidate.topic_title}</h4>
                <p class="candidate-dataset">
                  <strong>{candidate.data_feasibility.dataset_name}</strong><br />
                  <span>{candidate.data_feasibility.dataset_version}</span>
                </p>
                <dl class="candidate-contract">
                  <div>
                    <dt>Independent unit</dt>
                    <dd>{candidate.independent_unit.name} · n={candidate.independent_unit.observed_units}</dd>
                  </div>
                  <div>
                    <dt>Cheap baseline</dt>
                    <dd>{candidate.cheap_baseline.name}</dd>
                  </div>
                  <div>
                    <dt>Primary metric</dt>
                    <dd>{candidate.evaluation.primary_metric}</dd>
                  </div>
                  <div>
                    <dt>Validation plan at selection freeze</dt>
                    <dd>{candidate.evaluation.independent_validation}</dd>
                  </div>
                </dl>
                <p class="candidate-estimate">
                  CPU · {candidate.compute.estimated_runtime_minutes} min · {candidate.compute.estimated_memory_gb} GB RAM · {candidate.compute.estimated_download_mb} MB download
                </p>
                <p class="candidate-licence">Licence: {candidate.licence.name}</p>
                <p class="candidate-progress-note">{candidate.implementation.note}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <p class="notice">
        No v0.2b depth candidate passed every frozen eligibility criterion. The
        criteria were not weakened to fill the tranche.
      </p>
    )}
  </section>

  <section class="section self-audit" aria-labelledby="self-audit-title">
    <p class="eyebrow">Unresolved internal coverage</p>
    <h2 id="self-audit-title">Self-audit needed</h2>
    <p class="section-intro">
      These {comparison.gaps.self_audit_needed.length} AIDD Commons cells are
      unverified and must not be interpreted as a confirmed deficiency. Review our
      own published lessons before assigning depth work.
    </p>
    <p class="section-intro">
      One reading has already tested this record against something else: a reviewer
      from a different model family read the same topics and read them deeper than
      this project recorded.
    </p>
    <AtlasFigure id="second-reading" />
    <details>
      <summary>Show topics awaiting self-audit</summary>
      <ul class="self-audit-list">
        {comparison.gaps.self_audit_needed.map((gap) => (
          <li>
            <strong>{gap.topic_title}</strong>
            <span>{comparisonTrackTitle(gap.track_id)} · strongest external evidence: {label(gap.strongest_external_depth)}</span>
          </li>
        ))}
      </ul>
    </details>
  </section>
</SiteShell>
