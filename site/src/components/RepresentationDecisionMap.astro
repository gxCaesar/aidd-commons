---
const steps = [
  {
    number: "01",
    title: "Resolve the entity",
    body: "Parent, salt, mixture, protomer, tautomer, stereoisomer, conformer, or complex are different scientific objects.",
  },
  {
    number: "02",
    title: "Name endpoint dependence",
    body: "Ask whether the measurement can depend on connectivity, local motifs, stereochemistry, geometry, environment, or an ensemble.",
  },
  {
    number: "03",
    title: "Choose the least lossy baseline",
    body: "Begin with the lowest-cost representation that preserves the variables the endpoint can use.",
  },
  {
    number: "04",
    title: "Freeze a matched comparison",
    body: "Hold entities, labels, splits, preprocessing, and metrics fixed before changing the representation or encoder.",
  },
];

const families = [
  ["ID", "registry linkage"],
  ["DESC", "global scalars"],
  ["FP", "local environments"],
  ["2D", "connectivity graph"],
  ["SEQ", "serialized syntax"],
  ["3D", "state and geometry"],
];
---

<section
  class="representation-decision-map"
  aria-labelledby="representation-map-title"
  data-representation-map
>
  <header>
    <p class="representation-decision-map__eyebrow">Decision map</p>
    <h2 id="representation-map-title">Representation is a chain of scientific choices</h2>
    <p>
      The useful question is not “which encoding is best?” It is “which distinctions
      must survive for this endpoint and decision?”
    </p>
  </header>

  <ol class="representation-decision-map__steps">
    {steps.map((step) => (
      <li>
        <span aria-hidden="true">{step.number}</span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      </li>
    ))}
  </ol>

  <ul class="representation-decision-map__families" aria-label="Representation families">
    {families.map(([short, label]) => (
      <li>
        <strong>{short}</strong>
        <span>{label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .representation-decision-map {
    position: relative;
    margin-block: 2rem 3rem;
    overflow: hidden;
    border: 1px solid var(--atlas-rule);
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--atlas-coral) 14%, transparent),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--atlas-teal) 12%, var(--atlas-panel)),
        var(--atlas-panel) 58%
      );
    box-shadow: var(--atlas-shadow);
  }

  .representation-decision-map header {
    max-width: 48rem;
    padding: clamp(1.25rem, 4vw, 2.25rem);
  }

  .representation-decision-map__eyebrow {
    margin: 0 0 0.45rem;
    color: var(--atlas-teal-deep);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .representation-decision-map h2 {
    margin: 0;
    color: var(--atlas-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 4vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .representation-decision-map header > p:last-child {
    max-width: 62ch;
    margin-bottom: 0;
    color: var(--atlas-muted);
  }

  .representation-decision-map__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--atlas-rule);
    list-style: none;
  }

  .representation-decision-map__steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    padding: 1.1rem;
    border-right: 1px solid var(--atlas-rule);
    border-bottom: 1px solid var(--atlas-rule);
  }

  .representation-decision-map__steps li:nth-child(even) {
    border-right: 0;
  }

  .representation-decision-map__steps li > span {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    border: 1px solid var(--atlas-teal);
    border-radius: 50%;
    color: var(--atlas-teal-deep);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .representation-decision-map__steps h3 {
    margin: 0;
    color: var(--atlas-ink);
    font-size: 0.98rem;
  }

  .representation-decision-map__steps p {
    margin: 0.3rem 0 0;
    color: var(--atlas-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .representation-decision-map__families {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.45rem;
    margin: 0;
    padding: 1rem;
    list-style: none;
  }

  .representation-decision-map__families li {
    min-width: 0;
    padding: 0.65rem 0.45rem;
    border-top: 3px solid var(--atlas-teal);
    background: color-mix(in srgb, var(--atlas-bg) 65%, transparent);
    text-align: center;
  }

  .representation-decision-map__families strong,
  .representation-decision-map__families span {
    display: block;
  }

  .representation-decision-map__families strong {
    color: var(--atlas-ink);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .representation-decision-map__families span {
    margin-top: 0.2rem;
    color: var(--atlas-muted);
    font-size: 0.68rem;
    line-height: 1.3;
  }

  @media (max-width: 46rem) {
    .representation-decision-map__steps {
      grid-template-columns: 1fr;
    }

    .representation-decision-map__steps li,
    .representation-decision-map__steps li:nth-child(even) {
      border-right: 0;
    }

    .representation-decision-map__families {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
