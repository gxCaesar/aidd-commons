{
  "name": "aidd-commons",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm catalog:build && pnpm comparisons:build && pnpm --dir site dev",
    "build": "pnpm catalog:build && pnpm comparisons:build && pnpm --dir site build",
    "check": "pnpm catalog:validate && pnpm comparisons:validate && pnpm catalog:build && pnpm comparisons:build && pnpm --dir site check && pnpm --dir site build && pnpm test:unit",
    "catalog:build": "tsx scripts/catalog/export.ts",
    "catalog:validate": "tsx scripts/catalog/validate.ts",
    "comparisons:build": "tsx scripts/comparisons/export.ts",
    "coverage:build": "tsx scripts/curriculum/coverage.ts",
    "comparisons:validate": "tsx scripts/comparisons/validate.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "links:internal": "tsx scripts/quality/check-internal-links.ts",
    "citations:check": "tsx scripts/quality/check-citations.ts",
    "links:external": "tsx scripts/quality/check-external-links.ts",
    "release:build": "tsx scripts/release/build.ts",
    "release:scan": "tsx scripts/release/hygiene.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
